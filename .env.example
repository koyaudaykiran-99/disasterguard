# AI DisasterGuard — Environment Configuration Template
# Copy this file to .env and configure values appropriate for your environment.
# NEVER COMMIT .env CONTAINING REAL SECRETS TO VERSION CONTROL.

# Environment Selector: development | test | demo | production
ENVIRONMENT=development

# Database Configuration (PostgreSQL 18 + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disasterguard
ALLOW_SQLITE_FALLBACK=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Security & JWT Authentication
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Emergency Agent & LLM Provider
# Leave blank to run with the built-in deterministic FallbackAIProvider (air-gapped/offline safe)
GPT_ASTRA_API_KEY=
OPENAI_API_KEY=

# Weather Provider Configuration (real | cached | mock | simulation)
WEATHER_PROVIDER=real
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_LATITUDE=13.0827
WEATHER_LONGITUDE=80.2707
WEATHER_CACHE_MINUTES=15

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Logging & Operational Modes
LOG_LEVEL=INFO
MODEL_MODE=production
DEMO_NOTIFICATION_MODE=True
ENABLE_REAL_NOTIFICATIONS=False
